{
  "name": "repro-pilot",
  "version": "0.1.0",
  "description": "Evidence-driven GitHub issue reproduction and fixing workflow for Pi Coding Agent",
  "type": "module",
  "license": "MIT",
  "author": "Ze Yang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zemple/repro-pilot.git"
  },
  "homepage": "https://github.com/zemple/repro-pilot#readme",
  "bugs": {
    "url": "https://github.com/zemple/repro-pilot/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "github-issues",
    "bug-reproduction"
  ],
  "files": [
    "extensions",
    "skills",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "npm run typecheck && npm run check && npm test"
  },
  "pi": {
    "extensions": [
      "./extensions/repro-workflow/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "20.19.43",
    "typebox": "1.3.17",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
