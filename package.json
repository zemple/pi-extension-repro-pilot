{
  "name": "repro-pilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write ."
  },
  "pi": {
    "extensions": [
      "./extensions/repro-workflow/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@earendil-works/pi-ai": "0.74.2",
    "@earendil-works/pi-coding-agent": "0.74.2",
    "@types/node": "20.19.43",
    "typebox": "1.3.17",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
